+  --kd-space-2: 8px;
+  --kd-space-3: 12px;
+  --kd-space-4: 16px;
+  --kd-space-6: 24px;
+  --kd-space-8: 32px;
+  --kd-space-12: 48px;
+  --kd-space-16: 64px;
+
+  /* Four radii only: controls, cards, panels, pills */
+  --kd-radius-control: 12px;
+  --kd-radius-card: 16px;
+  --kd-radius-panel: 24px;
+  --kd-radius-pill: 999px;
+
+  /* Soft elevation; keep most panels border-led, not shadow-led */
+  --kd-shadow-card: 0 1px 3px rgba(0,0,0,.04), 0 8px 24px rgba(0,0,0,.045);
+  --kd-shadow-popover: 0 12px 36px rgba(0,0,0,.14);
+  --kd-shadow-phone: 0 22px 70px rgba(0,0,0,.22);

+  /* Typography: native SF on Apple platforms, Inter fallback elsewhere */
+  --kd-font-ui: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --kd-font-display: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --kd-text-xs: 12px;
+  --kd-text-sm: 14px;
+  --kd-text-base: 16px;
+  --kd-text-lg: 18px;
+  --kd-text-xl: 22px;
+  --kd-text-2xl: 28px;
+  --kd-text-3xl: clamp(32px, 3vw, 44px);
+  --kd-leading-tight: 1.12;
+  --kd-leading-body: 1.5;
+
+  /* Motion */
+  --kd-ease: cubic-bezier(.32, .72, 0, 1);
+  --kd-duration-fast: 140ms;
+  --kd-duration-normal: 240ms;
+  --kd-duration-slow: 360ms;
+
+  --kd-content-max: 1440px;
+  --kd-page-gutter: clamp(16px, 3vw, 40px);
+  --kd-topbar-height: 64px;
+}
+
+[data-theme="dark"] {
+  color-scheme: dark;
+  --kd-canvas: #000000;
+  --kd-surface: #1C1C1E;
+  --kd-surface-2: #2C2C2E;
+  --kd-surface-3: #3A3A3C;
+  --kd-ink: #F5F5F7;

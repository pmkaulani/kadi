+
+/* --------------------------------------------------------------------------
+   KADI visual repair: responsive live guest preview and category-led stationery
+   Kept at the end so the repaired preview wins over legacy invitation rules.
+   -------------------------------------------------------------------------- */
+.kadi-live-preview-device {
+  width: min(100%, 393px);
+  margin-inline: auto;
+  padding: 9px;
+  border: 1px solid #242421;
+  border-radius: 36px;
+  background: #141513;
+  box-shadow: 0 18px 42px rgba(20, 18, 14, .18), inset 0 0 0 1px rgba(255,255,255,.08);
+  transition: width 240ms cubic-bezier(.32,.72,0,1), border-radius 240ms cubic-bezier(.32,.72,0,1);
+}
+.kadi-live-preview-device--android { border-radius: 26px; padding: 7px; }
+.kadi-live-preview-device--desktop { width: 100%; padding: 5px; border-radius: 15px; }
+.kadi-live-preview-viewport {
+  height: min(70svh, 740px);
+  min-height: 540px;
+  border-radius: 27px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  background: #111;
+  scrollbar-color: rgba(255,255,255,.28) transparent;
+  scrollbar-width: thin;
+}
+.kadi-live-preview-device--android .kadi-live-preview-viewport { border-radius: 19px; }
+.kadi-live-preview-device--desktop .kadi-live-preview-viewport { height: min(72svh, 800px); min-height: 580px; border-radius: 10px; }
+.kadi-draft-preview.iv-world { min-height: 0; width: 100%; max-width: 100%; overflow: visible; }
+.kadi-draft-preview .iv-opening-stage {
+  min-height: clamp(560px, 70svh, 720px);
+  padding: 76px 14px 36px;
+}
+.kadi-draft-preview .iv-control-rail { padding: 14px 15px; }
+.kadi-draft-preview .iv-opening-copy { margin-bottom: 21px; max-width: 380px; }
+.kadi-draft-preview .iv-opening-title { font-size: clamp(23px, 4.5vw, 36px); }
+.kadi-draft-preview .iv-envelope-hitarea { width: min(310px, 86%); aspect-ratio: 1.48; }
+.kadi-draft-preview .iv-opening-status,
+.kadi-draft-preview .iv-open-instruction { margin-top: 18px; }
+.kadi-draft-preview .iv-opening-footer { display: none; }
+.kadi-draft-preview .iv-occasion-cover { min-height: 600px; padding: 52px 20px; }
+.kadi-draft-preview .iv-love-cover,
+.kadi-draft-preview .iv-garden-cover,
+.kadi-draft-preview .iv-memorial-cover,
+.kadi-draft-preview .iv-gifts-cover,
+.kadi-draft-preview .iv-disco-cover { padding-top: 48px; }
+.kadi-draft-preview .iv-love-cover__photo { height: clamp(200px, 38svh, 360px); }
+.kadi-draft-preview .iv-draft-preview__welcome,
+.kadi-draft-preview__welcome {
+  padding: 42px 20px;
+  text-align: center;
+  color: var(--iv-ink, #29211f);
+  background: var(--iv-paper, #fff9ef);
+  border-top: 1px solid var(--iv-line, rgba(53,39,33,.18));
+}
+.kadi-draft-preview__welcome h2 { margin: 10px auto; max-width: 650px; font: 500 clamp(28px, 4vw, 44px)/1.05 var(--iv-font-heading, Georgia, serif); letter-spacing: -.04em; }
+.kadi-draft-preview__welcome p { margin: 7px 0 0; font-size: 12px; line-height: 1.6; }
+.kadi-draft-preview__eyebrow { font-size: 9px !important; text-transform: uppercase; letter-spacing: .2em; opacity: .7; }
+
+/* Make the editor's selected palette, typeface, liner and styles affect the real envelope. */
+.iv-world[data-custom-design="true"] .iv-envelope-back {
+  background: var(--iv-envelope-color);
+  background-image: repeating-linear-gradient(0deg, rgba(255,255,255,.045) 0 1px, transparent 1px 4px), radial-gradient(ellipse at 25% 10%, rgba(255,255,255,.13), transparent 45%);
+  border-color: var(--iv-gold);
+  box-shadow: inset 0 0 0 3px rgba(20,5,8,.13), inset 0 0 0 4px color-mix(in srgb, var(--iv-gold) 35%, transparent);
+}

# ==========================================
# KADI ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================
# NOTE: Never commit real credentials or API secrets.
# All values below are placeholders and documentation for deployment.

# Node / App Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Kadi"

# Database (PostgreSQL / In-Memory Sandbox)
# Options: memory | postgres
DATABASE_ADAPTER=memory
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kadi_dev

# Authentication & Session Security (Cookie-based HMAC-SHA256 Sessions)
# Minimum 32-character high entropy key for signing session tokens and draft preview links
AUTH_SECRET=placeholder_super_secret_session_key_min_32_characters
SESSION_COOKIE_NAME=kadi_session
SESSION_EXPIRY_DAYS=7
NEXT_PUBLIC_AUTH_PROVIDER=cookie_hmac_local

# Object Storage (S3-compatible / Cloudflare R2 / Supabase Storage)
# Used for uploaded event photographs, music, and envelope liner assets
STORAGE_PROVIDER=mock_local
STORAGE_ENDPOINT=https://mock.storage.kadi.local
STORAGE_BUCKET=kadi-media-dev
STORAGE_ACCESS_KEY_ID=placeholder_storage_access_key
STORAGE_SECRET_ACCESS_KEY=placeholder_storage_secret_key
NEXT_PUBLIC_STORAGE_CDN_URL=http://localhost:3000/media

# Communication - Email (Transactional Adapter - Resend / Postmark / SendGrid)
EMAIL_PROVIDER=mock_console
EMAIL_FROM="Kadi Invitations <invitations@kadi.co.ke>"
EMAIL_API_KEY=placeholder_email_api_key

# Communication - WhatsApp (Meta WhatsApp Cloud API)
# Decision Gate: Automated sending is disabled until official Meta Business account approval & consent workflow.
# Native WhatsApp share links are used initially without requiring Cloud API credentials.
WHATSAPP_AUTOMATED_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=placeholder_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=placeholder_meta_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=placeholder_verify_token

# Payments - M-Pesa (Safaricom Daraja API)
# Decision Gate: Default is host-provided payment instructions. Direct collection/disbursement requires 
# verified paybill/till arrangement, compliance signoff, and live Daraja credentials.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=placeholder_daraja_consumer_key
MPESA_CONSUMER_SECRET=placeholder_daraja_consumer_secret
MPESA_PASSKEY=placeholder_daraja_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://api.kadi.co.ke/api/webhooks/mpesa
MPESA_DIRECT_COLLECTION_ENABLED=false

# Analytics & Observability
NEXT_PUBLIC_ANALYTICS_ENABLED=false
SENTRY_DSN=placeholder_sentry_dsn
